# AuraFit — Root .env file (Docker Compose development defaults)
# Copy to .env and adjust values. Never commit .env to git.
# For service-specific env vars, see each service's .env.example
# For full reference, see docs/ENVIRONMENT.md

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=aurafit
POSTGRES_PASSWORD=aurafit_dev_password_change_in_prod
POSTGRES_DB=aurafit

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_MAXMEMORY=1gb

# ── MinIO (local S3 replacement) ──────────────────────────────────────────────
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio123_change_in_prod

# ── Frontend public vars ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_REC_API_URL=http://localhost:8003/api/v1
NEXT_PUBLIC_VTRYON_API_URL=http://localhost:8020/api/v1

# ── Production overrides (used by docker-compose.prod.yml) ───────────────────
# NEXT_PUBLIC_API_URL=https://api.aurafit.ai/api/v1
# NEXT_PUBLIC_REC_API_URL=https://rec.aurafit.ai/api/v1
# NEXT_PUBLIC_VTRYON_API_URL=https://vtryon.aurafit.ai/api/v1

# ── Container registry (production CI/CD) ────────────────────────────────────
REGISTRY=ghcr.io
IMAGE_PREFIX=your-org/aurafit
IMAGE_TAG=latest
