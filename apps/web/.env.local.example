# AuraFit Web — Environment Variables
# Copy to .env.local and fill in values.

# API base URL (Nginx proxy in dev, CDN endpoint in prod)
NEXT_PUBLIC_API_URL=http://localhost:80

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Google OAuth (client ID only — secret stays on backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_OAUTH_STATE_SECRET=change-me-32-char-minimum
