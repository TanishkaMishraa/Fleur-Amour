# AuraFit User Service - Environment Variables
# Copy to .env and fill in values. Never commit .env to git.

# ── Core ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=DEBUG

# ── Security (generate with: openssl rand -hex 32) ───────────────────────────
SECRET_KEY=change-me-to-a-random-32-char-string-minimum

# RS256 keys (generate with: ssh-keygen -t rsa -b 4096)
# In production, inject from AWS Secrets Manager
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aurafit:aurafit@localhost:5432/aurafit
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_UPLOADS_BUCKET=aurafit-uploads-dev
S3_ASSETS_BUCKET=aurafit-assets-dev
CDN_BASE_URL=https://cdn.aurafit.ai

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:3000"]

# ── Internal services ─────────────────────────────────────────────────────────
PRODUCT_SERVICE_URL=http://localhost:8002
RECOMMENDATION_SERVICE_URL=http://localhost:8003
AI_FACIAL_SERVICE_URL=http://localhost:8010

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/oauth/callback

# ── Frontend URL (used in email links) ────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Stage 3: Auth & User Management additions ─────────────────────────────────

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Frontend URL (used in email verification + reset links)
FRONTEND_URL=http://localhost:3000

# Token expiry
EMAIL_VERIFY_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# MFA
MFA_ISSUER=AuraFit
